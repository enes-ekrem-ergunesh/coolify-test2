<%- include('_header', { activePage: 'home' }) %>

      <section class="card" style="margin-bottom:1rem;">
        <h2>Quick entry</h2>
        <form method="post" action="/entries">
          <input name="csrfToken" type="hidden" value="<%= csrfToken %>" />
          <label for="message" class="muted">Examples: "got salary 2k dollars", "market 5 USD", "bought a t-shirt for 5 bucks".</label>
          <textarea id="message" name="message" rows="3" placeholder="What did you do?" required></textarea>
          <button type="submit">Save message</button>
        </form>
      </section>

      <% if (stats.income_count + stats.expense_count === 0) { %>
        <div class="card" style="margin-bottom:1rem;"><p class="muted">No entries yet. Add your first entry above to start tracking.</p></div>
      <% } else { %>
        <div class="kpi-grid" style="margin-bottom:1rem;">
          <div class="card kpi">
            <div class="kpi-number positive"><%= stats.total_income_count %></div>
            <div class="kpi-label">Income entries</div>
          </div>
          <div class="card kpi">
            <div class="kpi-number negative"><%= stats.total_expense_count %></div>
            <div class="kpi-label">Expense entries</div>
          </div>
          <div class="card kpi">
            <div class="kpi-number" style="color:#facc15;"><%= pendingCount %></div>
            <div class="kpi-label">Pending review</div>
          </div>
          <% if (stats.top_expense_category) { %>
          <div class="card kpi">
            <div class="kpi-number" style="font-size:1.2rem;"><%= stats.top_expense_category %></div>
            <div class="kpi-label">Top expense category</div>
          </div>
          <% } %>
        </div>

        <section class="summary-grid" style="margin-bottom:1rem;">
          <% balances.forEach((row) => { %>
            <article class="card">
              <div style="font-size:0.8rem;color:#94a3b8;margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:0.05em;"><%= row.currency || 'N/A' %> — All time</div>
              <div class="compact-grid">
                <div>
                  <div class="muted" style="font-size:0.8rem;">Income</div>
                  <div class="number positive"><%= row.income_total %></div>
                </div>
                <div>
                  <div class="muted" style="font-size:0.8rem;">Expense</div>
                  <div class="number negative"><%= row.expense_total %></div>
                </div>
                <div>
                  <div class="muted" style="font-size:0.8rem;">Balance</div>
                  <div class="number <%= row.balance >= 0 ? 'positive' : 'negative' %>"><%= row.balance %></div>
                </div>
              </div>
            </article>
          <% }) %>
          <% thisMonth.forEach((row) => { %>
            <article class="card">
              <div style="font-size:0.8rem;color:#94a3b8;margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:0.05em;"><%= row.currency || 'N/A' %> — This month</div>
              <div class="compact-grid">
                <div>
                  <div class="muted" style="font-size:0.8rem;">Income</div>
                  <div class="number positive"><%= row.month_income %></div>
                </div>
                <div>
                  <div class="muted" style="font-size:0.8rem;">Expense</div>
                  <div class="number negative"><%= row.month_expense %></div>
                </div>
                <div>
                  <div class="muted" style="font-size:0.8rem;">Net</div>
                  <div class="number <%= (row.month_income - row.month_expense) >= 0 ? 'positive' : 'negative' %>"><%= (row.month_income - row.month_expense).toFixed(2) %></div>
                </div>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>

      <section class="card">
        <h2>Recent entries</h2>
        <ul class="list">
          <% if (recentEntries.length === 0) { %>
            <li class="item muted">No finalized entries yet.</li>
          <% } %>
          <% recentEntries.forEach((entry) => { %>
            <li class="item">
              <div><span class="pill <%= entry.type %>"><%= entry.type %></span> <strong><%= entry.amount %> <%= entry.currency %></strong> in <%= entry.category %></div>
              <div><%= entry.description %></div>
              <div class="muted" style="font-size:0.8rem;margin-top:0.25rem;"><%= entry.created_at %></div>
            </li>
          <% }) %>
        </ul>
      </section>

<%- include('_footer') %>
