<%- include('_header', { activePage: 'expenses' }) %>

      <section class="card">
        <h2>Expense entries</h2>
        <ul class="list">
          <% if (entries.length === 0) { %>
            <li class="item muted">No expense entries yet.</li>
          <% } %>
          <% entries.forEach((entry) => { %>
            <li class="item">
              <div><span class="pill expense">expense</span> <strong><%= entry.amount %> <%= entry.currency %></strong> in <%= entry.category %></div>
              <div><%= entry.description %></div>
              <div class="muted" style="font-size:0.8rem;margin-top:0.25rem;"><%= entry.created_at %></div>
            </li>
          <% }) %>
        </ul>
      </section>

<%- include('_footer') %>
